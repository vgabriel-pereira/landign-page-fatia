rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A autenticação identifica a conta; a custom claim autoriza a operação.
    // A claim `admin` só deve ser atribuída em ambiente confiável com o Admin SDK.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Produtos: leitura pública, manutenção exclusiva de administradores.
    match /produtos/{produtoId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Categorias: leitura pública para os filtros e manutenção pelo painel.
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avaliações:
    // - Leitura pública apenas das aprovadas
    // - Qualquer pessoa pode CRIAR (enviar avaliação)
    // - Apenas autenticado pode ATUALIZAR ou DELETAR (moderar)
    match /avaliacoes/{avaliacaoId} {
      allow read:   if resource.data.aprovada == true || isAdmin();
      allow create: if request.resource.data.keys().hasAll(['nome','mensagem','estrelas','aprovada','criadaEm'])
                    && request.resource.data.aprovada == false
                    && request.resource.data.estrelas is int
                    && request.resource.data.estrelas >= 1
                    && request.resource.data.estrelas <= 5
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() <= 80
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() > 0
                    && request.resource.data.mensagem.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // Bloqueia tudo o mais por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
